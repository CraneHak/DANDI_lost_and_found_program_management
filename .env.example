# ===== RDS (AWS) =====
DB_PASSWORD=<your-rds-dandi-password>

# ===== S3 (AWS) =====
AWS_ACCESS_KEY=<your-iam-access-key-id>
AWS_SECRET_KEY=<your-iam-secret-access-key>
S3_BUCKET_NAME=dandi-lost-items

# ===== CORS (comma-separated, no trailing slash) =====
# 예: http://localhost:3000,http://localhost:8085,http://<EC2_PUBLIC_IP>:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8085

FIREBASE_ADMIN_SDK_PATH=C:\Users\<your-user>\.secrets\firebase\myauth.json
FIREBASE_ALLOWED_DOMAIN=dankook.ac.kr
FIREBASE_ADMIN_UIDS=your-admin-uid
FIREBASE_ADMIN_EMAILS=admin@dankook.ac.kr
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\<your-user>\.secrets\cloudvisionapi\cloudvisionapi_cash.json
LLM_API_KEY=<your-gemini-api-key>
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CHATBOT_RATE_LIMIT_MINUTE=12
CHATBOT_RATE_LIMIT_HOUR=20
CHATBOT_RATE_LIMIT_DAY=30
CHATBOT_SANCTION_FIRST_BLOCK_MINUTES=15
CHATBOT_SANCTION_SECOND_BLOCK_HOURS=24
